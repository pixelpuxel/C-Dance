DOMAIN=cdance.schreiber.info
ACME_EMAIL=cdance@post.schreiber.info
HOST_PORT=8194
DOCKER_SUBNET=10.240.27.240/28

POSTGRES_DB=cdance
POSTGRES_USER=cdance
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://cdance:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/cdance
REDIS_URL=redis://redis:6379/0

JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
API_KEY_PEPPER=CHANGE_ME_ANOTHER_32_RANDOM_CHARACTERS
SETUP_TOKEN=CHANGE_ME_ONE_TIME_SETUP_TOKEN_AT_LEAST_32_CHARACTERS
JWT_TTL_MINUTES=15
PUBLIC_BASE_URL=https://cdance.schreiber.info
CORS_ORIGINS=https://cdance.schreiber.info

ARK_API_KEY=YOUR_VOLCENGINE_ARK_API_KEY
SEEDANCE_ENDPOINT=https://ark.ap-southeast.bytepluses.com/api/v3/contents/generations/tasks
SEEDANCE_MODEL=dreamina-seedance-2-5-260628
SEEDANCE_FLASH_MODEL=dreamina-seedance-2-5-flash-261115
SEEDANCE_20_MODEL=dreamina-seedance-2-0-260128
SEEDANCE_FAST_MODEL=dreamina-seedance-2-0-fast-260128
SEEDANCE_RESOLUTIONS=480p,720p,1080p,4k
SEEDANCE_DEFAULT_RESOLUTION=720p
SEEDANCE_DEFAULT_DURATION=5
SEEDANCE_GENERATE_AUDIO=true
SEEDANCE_WATERMARK=false
PROVIDER_TIMEOUT_SECONDS=2100
PROVIDER_POLL_INTERVAL_SECONDS=20

STORAGE_BACKEND=local
STORAGE_ROOT=/data/storage
MAX_UPLOAD_BYTES=209715200
RATE_LIMIT_PER_MINUTE=60
GENERATION_RATE_LIMIT_PER_MINUTE=10

# Apple Push Notification service (APNs). Der private Schlüssel wird als Base64-Wert gesetzt.
APNS_TEAM_ID=TVU2AD92HJ
APNS_KEY_ID=REPLACE_WITH_APNS_KEY_ID
APNS_PRIVATE_KEY_B64=REPLACE_WITH_BASE64_ENCODED_P8_KEY
APNS_TOPIC=info.schreiber.cdance

# Ein über die Web-App erzeugter eigener Backend-API-Key nur für den MCP-Container.
MCP_BACKEND_API_KEY=cd_REPLACE_WITH_CREATED_BACKEND_KEY
# Passwort fuer die einmalige OAuth-Freigabe externer MCP-Clients.
# Nicht in Clients eintragen: ChatGPT/Codex erhalten nach PKCE-Freigabe eigene Tokens.
MCP_ACCESS_TOKEN=CHANGE_ME_LONG_RANDOM_MCP_ACCESS_TOKEN
MCP_POLL_TIMEOUT=2100
